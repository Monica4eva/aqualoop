{
  "expo": {
    "name": "AquaLoop",
    "slug": "expo-base",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expobase",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "package": "app.newly.preview",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-newly-build-provenance",
      [
        "expo-dev-client",
        {
          "android": {
            "launchMode": "most-recent",
            "toolsButton": false,
            "skipOnboarding": true,
            "showMenuAtLaunch": false
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "AquaLoop uses the microphone so you can send your order as a voice note."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-sqlite",
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2d505456-c081-4caf-8c2b-754446471857"
      }
    }
  }
}
